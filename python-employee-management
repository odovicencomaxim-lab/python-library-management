class dipendente():
    def __init__(self,id_emp,nome,cognome,stipendio_base):
        self.id_emp = id_emp
        self.nome = nome
        self.cognome = cognome
        self.stipendio_base = stipendio_base
    def calcola_stipendio(self):
        return self.stipendio_base
class sviluppatore(dipendente):
    def __init__(self, id_emp, nome, cognome, stipendio_base,bonus_progetto):
        super().__init__(id_emp, nome, cognome, stipendio_base,)
        self.bonus_progetto = bonus_progetto
    def calcola_stipendio(self):
        return super().calcola_stipendio() + self.bonus_progetto
class venditore(dipendente):
    def __init__(self, id_emp, nome, cognome, stipendio_base,vendite_totali,percentuale_provvigione):
        super().__init__(id_emp, nome, cognome, stipendio_base)
        self.vendite_totali = vendite_totali
        self.percentuale_provvigione = percentuale_provvigione
    def calcola_stipendio(self):
        return super().calcola_stipendio() + (self.vendite_totali * (self.percentuale_provvigione / 100))

